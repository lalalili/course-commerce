{
    "name": "lalalili/course-commerce",
    "description": "Commerce adapter for lalalili/course-core access and product resolution.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "lalalili/commerce-core": "^1.0",
        "lalalili/course-core": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "laravel/pint": "^1.0",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Lalalili\\CourseCommerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lalalili\\CourseCommerce\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/lalalili/commerce-core.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/lalalili/course-core.git"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Lalalili\\CourseCommerce\\CourseCommerceServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
        "format": "pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}
